{
  "source": {
    "include": ["src"],
    "includePattern": "\\.jsx?$",
    "excludePattern": "(node_modules|dist|build)"
  },
  "opts": {
    "destination": "docs",
    "recurse": true
  },
  "plugins": ["plugins/markdown"],
  "templates": {
    "cleverLinks": true,
    "monospaceLinks": true
  }
}
